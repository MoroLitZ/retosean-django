# Copy this file to rust/.env and set your local PostgreSQL credentials.
# If absent, connection settings are read from the Django ../.env file.
DB_HOST=localhost
DB_PORT=5432
DB_USER=retosean
DB_PASSWORD=replace-with-your-local-password

# Docker compose (compose.yml) reads this same rust/.env file (OPS-9).
# RUST_POSTGRES_PASSWORD is required to start the stack and feeds both
# POSTGRES_PASSWORD (db container) and DB_PASSWORD (web container).
# RUST_POSTGRES_PASSWORD=replace-with-your-compose-password

# A separate database; the Django DB_NAME is deliberately not used.
RUST_DB_NAME=retosean_rust
RUST_BIND=127.0.0.1:8080
RUST_MEDIA_DIR=.rust-media
RUST_SECURE_COOKIE=false
RUST_LOG=retosean=info

# Notification email: same settings as Django. Without EMAIL_HOST, emails are
# only logged (Django's console backend).
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=RetosEAN <no-responder@universidadean.edu.co>
# RUST_SITE_URL=http://127.0.0.1:8080
