# Aplicación Rust: carga .env y ../.env desde el directorio de trabajo.

# Base de datos (config.rs)
# Por defecto: retosean_rust
RUST_DB_NAME=retosean_rust
# Por defecto: localhost
DB_HOST=localhost
# Por defecto: 5432
DB_PORT=5432
# Por defecto: retosean
DB_USER=retosean
# Por defecto: vacío; ejemplo local
DB_PASSWORD=retosean123

# App (config.rs)
# Por defecto: 127.0.0.1:8080
RUST_BIND=127.0.0.1:8080
# Por defecto: false; solo producción detrás de HTTPS: true
RUST_SECURE_COOKIE=false
# Por defecto: .rust-media; solo producción: ruta persistente
RUST_MEDIA_DIR=.rust-media

# Correo (mail.rs)
# Por defecto: vacío. Si contiene console/locmem, fuerza consola.
EMAIL_BACKEND=
# Por defecto: vacío => consola. Solo producción: host SMTP.
EMAIL_HOST=
# Por defecto: 587
EMAIL_PORT=587
# Por defecto: true
EMAIL_USE_TLS=True
# Por defecto: vacío. Solo producción: usuario SMTP.
EMAIL_HOST_USER=
# Por defecto: vacío. Solo producción: contraseña SMTP.
EMAIL_HOST_PASSWORD=
# Por defecto: RetosEAN <no-responder@universidadean.edu.co>
DEFAULT_FROM_EMAIL=RetosEAN <no-responder@universidadean.edu.co>